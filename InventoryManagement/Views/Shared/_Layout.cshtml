@using Inventory.Utility;
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MP Online group 5 Inventory Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryManagement.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <link rel="stylesheet" href="//cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" asp-append-version="true" />
    <style>
        .navbar-custom {
            background-color: #f7c325 !important;
        }
        .active-view-badge {
            border: 2px solid #000 !important;
            transform: scale(1.04);
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-custom border-bottom shadow-sm mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-dark fs-4" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-box-seam text-dark me-1"></i> MP Online group 5 <span class="badge bg-dark text-warning fs-6">Inventory Manager</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fw-semibold">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-speedometer2"></i> Admin Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-controller="LabSupplies" asp-action="Index">
                                <i class="bi bi-box-seam"></i> Catalog & SKUs
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-controller="Suppliers" asp-action="Index">
                                <i class="bi bi-building"></i> Dark Stores & Vendors
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-controller="StockAdjustment" asp-action="Index">
                                <i class="bi bi-arrow-left-right"></i> Stock Adjustments
                            </a>
                        </li>
                    </ul>

                    @* Two Distinct View Switches: Admin View vs Debug Website *@
                    <div class="d-flex align-items-center flex-wrap gap-2 me-lg-3 my-2 my-lg-0">
                        <span class="text-dark-50 small fw-bold d-none d-xl-inline"><i class="bi bi-eye-fill"></i> Switch View:</span>
                        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" 
                           class="btn btn-sm btn-dark text-warning fw-bold shadow-sm active-view-badge"
                           title="Switch to Admin Warehouse View">
                            <i class="bi bi-shield-lock-fill text-warning me-1"></i> Admin View
                        </a>
                        <a asp-area="Debug" asp-controller="DebugDashboard" asp-action="Index" 
                           class="btn btn-sm btn-danger text-white fw-bold shadow-sm"
                           title="Switch to Debug Website & Simulator">
                            <i class="bi bi-bug-fill text-warning me-1"></i> Debug Website
                        </a>
                    </div>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            <partial name="_Notification"/>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-dark text-white py-3 mt-auto">
        <div class="container text-center">
            <p class="mb-0 fw-semibold text-white-50">
                &copy; @DateTime.Now.Year - <strong class="text-warning">MP Online group 5 Inventory Manager</strong> | E-Commerce Dark Store Backend Warehouse
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="//cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
