@{
    ViewData["Title"] = "Blinkit Dark Store Admin";
    var products = ViewBag.Products as IEnumerable<Inventory.Models.Models.Product>;
    var lowStockItems = ViewBag.LowStockItems as IEnumerable<Inventory.Models.Models.Product>;
    var recentOrders = ViewBag.RecentOrders as IEnumerable<Inventory.Models.Models.WarehouseOrder>;
}

<div class="container-fluid py-3">
    <!-- Title & View Switch Banner -->
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold mb-2">
                    <i class="bi bi-lightning-charge-fill me-1"></i> Blinkit Quick-Commerce Operations
                </span>
                <h2 class="fw-bold mb-0 text-dark">Dark Store Warehouse Admin Control</h2>
            </div>
            <div>
                <a asp-area="Debug" asp-controller="DebugDashboard" asp-action="Index" class="btn btn-dark btn-lg shadow">
                    <i class="bi bi-bug-fill text-warning me-1"></i> Open Debug Website & Simulator
                </a>
            </div>
        </div>
    </div>

    <!-- Metrics Row -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-dark-50 small fw-bold text-uppercase">Total Catalog SKUs</div>
                            <div class="fs-2 fw-bold">@ViewBag.TotalProducts</div>
                        </div>
                        <i class="bi bi-box-seam fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase">Total Inventory Valuation</div>
                            <div class="fs-2 fw-bold">₹@ViewBag.TotalInventoryValue</div>
                        </div>
                        <i class="bi bi-currency-rupee fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase">Low Stock Restock Alerts</div>
                            <div class="fs-2 fw-bold">@ViewBag.LowStockCount</div>
                        </div>
                        <i class="bi bi-exclamation-triangle fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-white-50 small fw-bold text-uppercase">Active Dark Stores</div>
                            <div class="fs-2 fw-bold">@ViewBag.TotalDarkStores Hubs</div>
                        </div>
                        <i class="bi bi-building fs-1 opacity-50"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Tables -->
    <div class="row g-4">
        <!-- Low Stock Alert Table -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-exclamation-octagon-fill me-2"></i>Urgent Stock Replenishment Needed</h5>
                    <span class="badge bg-danger">Low Stock</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>SKU</th>
                                    <th>Product Name</th>
                                    <th>Location</th>
                                    <th>Stock</th>
                                    <th>Min</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (lowStockItems != null && lowStockItems.Any())
                                {
                                    foreach (var item in lowStockItems)
                                    {
                                        <tr class="table-danger">
                                            <td><code class="fw-bold">@item.SKU</code></td>
                                            <td class="fw-bold">@item.Name</td>
                                            <td><span class="badge bg-light text-dark border"><i class="bi bi-geo-alt me-1"></i>@item.AisleLocation</span></td>
                                            <td><span class="badge bg-danger fs-6">@item.QuantityOnHand</span></td>
                                            <td>@item.MinStockLevel</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="bi bi-check-circle-fill text-success fs-2 d-block mb-2"></i>
                                            All inventory items are above reorder thresholds!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Dark Store Orders -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold text-warning"><i class="bi bi-cart-check-fill me-2"></i>Live Fulfillment & Picking Queue</h5>
                    <span class="badge bg-warning text-dark">Real-Time Orders</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Order Code</th>
                                    <th>Customer</th>
                                    <th>Status</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (recentOrders != null && recentOrders.Any())
                                {
                                    foreach (var ord in recentOrders)
                                    {
                                        <tr>
                                            <td><code class="fw-bold text-dark">@ord.OrderCode</code></td>
                                            <td>@ord.CustomerName</td>
                                            <td><span class="badge bg-info text-dark fw-bold"><i class="bi bi-box-arrow-in-right me-1"></i>@ord.OrderStatus</span></td>
                                            <td class="fw-bold">₹@ord.TotalAmount</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                            No active warehouse picking orders. Use the Debug Website to simulate orders!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
