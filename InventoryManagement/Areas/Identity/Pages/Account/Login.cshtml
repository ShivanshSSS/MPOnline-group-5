@page
@model LoginModel
@{
    ViewData["Title"] = "Login - MP Online group 5 Inventory Manager";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-lg-5 col-md-7 col-sm-9">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-warning text-center py-4">
                    <i class="bi bi-box-seam fs-1 mb-2 d-block text-warning"></i>
                    <h2 class="mb-0 fw-bold">MP Online group 5 <span class="badge bg-warning text-dark fs-6">Inventory Manager</span></h2>
                    <p class="mb-0 mt-2 text-white-50">Sign in to Warehouse & Dark Store Engine</p>
                </div>
                <div class="card-body p-4">
                    <!-- Quick Demo Credentials Box -->
                    <div class="alert alert-warning border-warning mb-4">
                        <div class="fw-bold mb-2 text-dark"><i class="bi bi-key-fill me-1"></i> Quick Demo Login Credentials:</div>
                        <div class="d-grid">
                            <button type="button" class="btn btn-dark btn-sm text-start" onclick="fillAdminCredentials()">
                                <strong>🔑 Admin Account:</strong> <code>admin@mponline.com</code> | <code>Admin123!</code>
                            </button>
                        </div>
                    </div>

                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label fw-bold">
                                <i class="bi bi-envelope-fill me-1"></i> Email Address
                            </label>
                            <input asp-for="Input.Email" id="inputEmail" class="form-control form-control-lg" autocomplete="username" placeholder="admin@mponline.com" aria-required="true" />
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <label asp-for="Input.Password" class="form-label fw-bold">
                                <i class="bi bi-lock-fill me-1"></i> Password
                            </label>
                            <input asp-for="Input.Password" id="inputPassword" class="form-control form-control-lg" autocomplete="current-password" placeholder="••••••••" aria-required="true" />
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>
                        
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Input.RememberMe" />
                                <label class="form-check-label" asp-for="Input.RememberMe">
                                    Remember me on this device
                                </label>
                            </div>
                        </div>
                        
                        <div class="d-grid mb-3">
                            <button id="login-submit" type="submit" class="btn btn-warning btn-lg fw-bold text-dark shadow-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillAdminCredentials() {
            document.getElementById('inputEmail').value = 'admin@mponline.com';
            document.getElementById('inputPassword').value = 'Admin123!';
        }
    </script>
}
